EVALUATE
UNION(
 ROW("Check","Rows MonthlyCity","Kind","Number","Value",FORMAT(COUNTROWS(MonthlyCity),"0.###############","en-US")),
 ROW("Check","Rows Acquisition","Kind","Number","Value",FORMAT(COUNTROWS(Acquisition),"0.###############","en-US")),
 ROW("Check","Rows Retention","Kind","Number","Value",FORMAT(COUNTROWS(Retention),"0.###############","en-US")),
 ROW("Check","Rows CustomerSegments","Kind","Number","Value",FORMAT(COUNTROWS(CustomerSegments),"0.###############","en-US")),
 ROW("Check","Rows CategorySales","Kind","Number","Value",FORMAT(COUNTROWS(CategorySales),"0.###############","en-US")),
 ROW("Check","Net Revenue","Kind","Number","Value",FORMAT([Net Revenue],"0.###############","en-US")),
 ROW("Check","Completed Orders","Kind","Number","Value",FORMAT([Completed Orders],"0.###############","en-US")),
 ROW("Check","Average Order Value","Kind","Number","Value",FORMAT([Average Order Value],"0.###############","en-US")),
 ROW("Check","Total Sessions","Kind","Number","Value",FORMAT([Total Sessions],"0.###############","en-US")),
 ROW("Check","Converted Sessions","Kind","Number","Value",FORMAT([Converted Sessions],"0.###############","en-US")),
 ROW("Check","Session Conversion Rate","Kind","Number","Value",FORMAT([Session Conversion Rate],"0.###############","en-US")),
 ROW("Check","Average Delivery Minutes","Kind","Number","Value",FORMAT([Average Delivery Minutes],"0.###############","en-US")),
 ROW("Check","Traffic Sessions","Kind","Number","Value",FORMAT([Traffic Sessions],"0.###############","en-US")),
 ROW("Check","Traffic Conversions","Kind","Number","Value",FORMAT([Traffic Conversions],"0.###############","en-US")),
 ROW("Check","Traffic Conversion Rate","Kind","Number","Value",FORMAT([Traffic Conversion Rate],"0.###############","en-US")),
 ROW("Check","Segment Buyers","Kind","Number","Value",FORMAT([Segment Buyers],"0.###############","en-US")),
 ROW("Check","Segment Revenue","Kind","Number","Value",FORMAT([Segment Revenue],"0.###############","en-US")),
 ROW("Check","Revenue per Buyer","Kind","Number","Value",FORMAT([Revenue per Buyer],"0.###############","en-US")),
 ROW("Check","Repeat Buyer Rate","Kind","Number","Value",FORMAT([Repeat Buyer Rate],"0.###############","en-US")),
 ROW("Check","Inactive Buyer Rate","Kind","Number","Value",FORMAT([Inactive Buyer Rate],"0.###############","en-US")),
 ROW("Check","Product Sales","Kind","Number","Value",FORMAT([Product Sales],"0.###############","en-US")),
 ROW("Check","Product Units","Kind","Number","Value",FORMAT([Product Units],"0.###############","en-US")),
 ROW("Check","Category Sales Share","Kind","Number","Value",FORMAT([Category Sales Share],"0.###############","en-US")),
 ROW("Check","Revenue display","Kind","Text","Value",[Revenue (synthetic dollars)]),
 ROW("Check","Orders display","Kind","Text","Value",[Orders completed]),
 ROW("Check","Cohort total blank","Kind","Blank","Value",FORMAT([Cohort Retention Rate],"0.###############","en-US")),
 ROW("Check","Cohort month 0","Kind","Number","Value",FORMAT(CALCULATE([Cohort Retention Rate],Retention[MonthIndex]=0),"0.###############","en-US")),
 ROW("Check","Cohort month 1","Kind","Number","Value",FORMAT(CALCULATE([Cohort Retention Rate],Retention[MonthIndex]=1),"0.###############","en-US")),
 ROW("Check","Cohort September month 1","Kind","Number","Value",FORMAT(CALCULATE([Cohort Retention Rate],Retention[Cohort]="2025-09",Retention[MonthIndex]=1),"0.###############","en-US")),
 ROW("Check","Cohort future February month 1","Kind","Blank","Value",FORMAT(CALCULATE([Cohort Retention Rate],Retention[Cohort]="2026-02",Retention[MonthIndex]=1),"0.###############","en-US")),
 ROW("Check","Tehran revenue","Kind","Number","Value",FORMAT(CALCULATE([Net Revenue],MonthlyCity[City]="Tehran"),"0.###############","en-US")),
 ROW("Check","Tehran orders","Kind","Number","Value",FORMAT(CALCULATE([Completed Orders],MonthlyCity[City]="Tehran"),"0.###############","en-US")),
 ROW("Check","Tehran AOV","Kind","Number","Value",FORMAT(CALCULATE([Average Order Value],MonthlyCity[City]="Tehran"),"0.###############","en-US")),
 ROW("Check","Tehran conversion","Kind","Number","Value",FORMAT(CALCULATE([Session Conversion Rate],MonthlyCity[City]="Tehran"),"0.###############","en-US")),
 ROW("Check","Tehran delivery","Kind","Number","Value",FORMAT(CALCULATE([Average Delivery Minutes],MonthlyCity[City]="Tehran"),"0.###############","en-US")),
 ROW("Check","September revenue","Kind","Number","Value",FORMAT(CALCULATE([Net Revenue],MonthlyCity[Month]=DATE(2025,9,1)),"0.###############","en-US")),
 ROW("Check","Referral Mobile conversion","Kind","Number","Value",FORMAT(CALCULATE([Traffic Conversion Rate],Acquisition[Channel]="Referral",Acquisition[Device]="Mobile"),"0.###############","en-US")),
 ROW("Check","Champions repeat rate","Kind","Number","Value",FORMAT(CALCULATE([Repeat Buyer Rate],CustomerSegments[Segment]="Champions"),"0.###############","en-US")),
 ROW("Check","Category selection share","Kind","Number","Value",FORMAT(CALCULATE([Category Sales Share],CategorySales[Category] IN {"Bakery","Beverage"}),"0.###############","en-US"))
)
ORDER BY [Check]
